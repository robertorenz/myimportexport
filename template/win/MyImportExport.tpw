#!============================================================================
#! MyImportExport.tpw - groups for MyImportExport.tpl
#! Everything in here is a #GROUP; it is #INCLUDEd at the very end of the .tpl
#!============================================================================
#!
#!----------------------------------------------------------------------------
#! Read MyImportExport.inc (found through the redirection file, as the CapeSoft
#! class reader does - cape02.tpw %ReadIncludeFilePR) to learn
#!   - whether the header derives _MIELinkMode_ from _MIEDllMode_ itself
#!     (then only _MIEDllMode_ may be a project define, or the label clashes)
#!   - the method prototypes of MyImportExportClass, so a DLL can export the
#!     class with LINKNAME() and nothing has to be maintained by hand.
#!----------------------------------------------------------------------------
#GROUP(%MIEReadInc),AUTO
#DECLARE(%MIELine)
#DECLARE(%MIEUp)
#DECLARE(%MIEPos)
#DECLARE(%MIEInClass)
#DECLARE(%MIEMethodName)
#DECLARE(%MIEMethodProto)
#FREE(%MIEIncMethods)
#SET(%MIEIncFound,0)
#SET(%MIEIncDefinesLink,1)
#SET(%MIEIncFile,'MyImportExport.inc')
#IF(NOT FILEEXISTS(%MIEIncFile))
  #RETURN
#ENDIF
#SET(%MIEIncFound,1)
#SET(%MIEIncDefinesLink,0)
#SET(%MIEInClass,0)
#OPEN(%MIEIncFile),READ
#READ(%MIELine)
#LOOP,WHILE(%MIELine <> %EOF)
  #SET(%MIEPos,INSTRING('!',%MIELine,1,1))
  #IF(%MIEPos)
    #SET(%MIELine,SUB(%MIELine,1,%MIEPos-1))
  #ENDIF
  #SET(%MIEUp,UPPER(CLIP(%MIELine)))
  #IF(INSTRING('_MIELINKMODE_',%MIEUp,1,1)=1 AND INSTRING('EQUATE',%MIEUp,1,1))
    #SET(%MIEIncDefinesLink,1)
  #ENDIF
  #IF(%MIEInClass=0)
    #IF(INSTRING('MYIMPORTEXPORTCLASS ',%MIEUp,1,1)=1 AND INSTRING(' CLASS',%MIEUp,1,1))
      #SET(%MIEInClass,1)
    #ENDIF
  #ELSE
    #IF(CLIP(LEFT(%MIEUp))='END' OR CLIP(LEFT(%MIEUp))='.')
      #SET(%MIEInClass,0)
    #ELSE
      #SET(%MIEPos,INSTRING(' PROCEDURE',%MIEUp,1,1))
      #IF(%MIEPos AND INSTRING(',PRIVATE',%MIEUp,1,1)=0)
        #SET(%MIEMethodName,CLIP(LEFT(SUB(%MIELine,1,%MIEPos))))
        #SET(%MIEMethodProto,CLIP(LEFT(SUB(%MIELine,%MIEPos+10,LEN(%MIELine)))))
        #IF(SUB(%MIEMethodProto,1,1)<>'(')
          #SET(%MIEMethodProto,'()' & %MIEMethodProto)
        #ENDIF
        #ADD(%MIEIncMethods,%MIEMethodName & %MIEMethodProto)
      #ENDIF
    #ENDIF
  #ENDIF
  #READ(%MIELine)
#ENDLOOP
#CLOSE(%MIEIncFile),READ
#!
#!----------------------------------------------------------------------------
#! Walk the fields of the current %File.
#!   %pEmit = 0 : only count the usable fields (returned)
#!   %pEmit = 1 : emit one SELF.AddField(...) per usable field / element
#! Skipped: END markers, GROUPs (their children are used, unless the GROUP
#! is OVER()'d, DIM()'d or MIEEXCLUDE'd), MEMO, BLOB, OVER() fields, and
#! fields whose User Options contain MIEEXCLUDE.
#!----------------------------------------------------------------------------
#GROUP(%MIEFieldLoop,%pEmit),AUTO
#DECLARE(%MIECnt)
#DECLARE(%MIEDepth)
#DECLARE(%MIESkipDepth)
#DECLARE(%MIEIsKey)
#DECLARE(%MIECol)
#DECLARE(%MIEPic)
#DECLARE(%MIEType)
#DECLARE(%MIEI1)
#DECLARE(%MIEI2)
#DECLARE(%MIEI3)
#DECLARE(%MIEI4)
#SET(%MIECnt,0)
#SET(%MIEDepth,0)
#SET(%MIESkipDepth,0)
#IF(%pEmit)
  #FREE(%MIEKeyFields)
  #IF(%FilePrimaryKey)
    #FIX(%Key,%FilePrimaryKey)
    #FOR(%KeyField)
      #ADD(%MIEKeyFields,%KeyField)
    #ENDFOR
  #ENDIF
#ENDIF
#FOR(%Field)
  #SET(%MIEType,UPPER(%FieldType))
  #IF(%FieldID='' OR %MIEType='END')
    #IF(%MIEDepth > 0)
      #IF(%MIESkipDepth = %MIEDepth)
        #SET(%MIESkipDepth,0)
      #ENDIF
      #SET(%MIEDepth,%MIEDepth-1)
    #ENDIF
    #CYCLE
  #ENDIF
  #IF(%MIEType='GROUP')
    #SET(%MIEDepth,%MIEDepth+1)
    #IF(%MIESkipDepth=0)
      #IF(EXTRACT(UPPER(%FieldStatement),'OVER') OR %FieldDimension1 > 0 OR INSTRING('MIEEXCLUDE',UPPER(%FieldUserOptions),1,1))
        #SET(%MIESkipDepth,%MIEDepth)
      #ENDIF
    #ENDIF
    #CYCLE
  #ENDIF
  #IF(%MIESkipDepth)
    #CYCLE
  #ENDIF
  #IF(%MIEType='MEMO' OR %MIEType='BLOB')
    #CYCLE
  #ENDIF
  #IF(INSTRING('MIEEXCLUDE',UPPER(%FieldUserOptions),1,1))
    #CYCLE
  #ENDIF
  #IF(EXTRACT(UPPER(%FieldStatement),'OVER'))
    #CYCLE
  #ENDIF
  #SET(%MIECnt,%MIECnt+1)
  #IF(%pEmit)
    #IF(INLIST(%Field,%MIEKeyFields))
      #SET(%MIEIsKey,1)
    #ELSE
      #SET(%MIEIsKey,0)
    #ENDIF
    #SET(%MIECol,%MIEColumnName(%FieldName,%FieldID))
    #SET(%MIEPic,%FieldDisplayPicture)
    #IF(%MIEPic='')
      #SET(%MIEPic,%MIEFallbackPicture(%MIEType,%FieldPlaces))
    #ENDIF
    #IF(%FieldDimension4 > 0)
      #LOOP,FOR(%MIEI1,1,%FieldDimension1)
        #LOOP,FOR(%MIEI2,1,%FieldDimension2)
          #LOOP,FOR(%MIEI3,1,%FieldDimension3)
            #LOOP,FOR(%MIEI4,1,%FieldDimension4)
    SELF.AddField('%Field[%MIEI1,%MIEI2,%MIEI3,%MIEI4]','%(%MIECol & '_' & %MIEI1 & '_' & %MIEI2 & '_' & %MIEI3 & '_' & %MIEI4)','%MIEType','%(QUOTE(%MIEPic))',%Field[%MIEI1,%MIEI2,%MIEI3,%MIEI4],%MIEIsKey)
            #ENDLOOP
          #ENDLOOP
        #ENDLOOP
      #ENDLOOP
    #ELSIF(%FieldDimension3 > 0)
      #LOOP,FOR(%MIEI1,1,%FieldDimension1)
        #LOOP,FOR(%MIEI2,1,%FieldDimension2)
          #LOOP,FOR(%MIEI3,1,%FieldDimension3)
    SELF.AddField('%Field[%MIEI1,%MIEI2,%MIEI3]','%(%MIECol & '_' & %MIEI1 & '_' & %MIEI2 & '_' & %MIEI3)','%MIEType','%(QUOTE(%MIEPic))',%Field[%MIEI1,%MIEI2,%MIEI3],%MIEIsKey)
          #ENDLOOP
        #ENDLOOP
      #ENDLOOP
    #ELSIF(%FieldDimension2 > 0)
      #LOOP,FOR(%MIEI1,1,%FieldDimension1)
        #LOOP,FOR(%MIEI2,1,%FieldDimension2)
    SELF.AddField('%Field[%MIEI1,%MIEI2]','%(%MIECol & '_' & %MIEI1 & '_' & %MIEI2)','%MIEType','%(QUOTE(%MIEPic))',%Field[%MIEI1,%MIEI2],%MIEIsKey)
        #ENDLOOP
      #ENDLOOP
    #ELSIF(%FieldDimension1 > 0)
      #LOOP,FOR(%MIEI1,1,%FieldDimension1)
    SELF.AddField('%Field[%MIEI1]','%(%MIECol & '_' & %MIEI1)','%MIEType','%(QUOTE(%MIEPic))',%Field[%MIEI1],%MIEIsKey)
      #ENDLOOP
    #ELSE
    SELF.AddField('%Field','%MIECol','%MIEType','%(QUOTE(%MIEPic))',%Field,%MIEIsKey)
    #ENDIF
  #ENDIF
#ENDFOR
#RETURN(%MIECnt)
#!
#!----------------------------------------------------------------------------
#! Column name: the field's external NAME() if it has one (quotes and any
#! "| READONLY" style driver flags removed), else the label without prefix.
#!----------------------------------------------------------------------------
#GROUP(%MIEColumnName,%pExternal,%pId),AUTO
#DECLARE(%MIEN)
#SET(%MIEN,CLIP(LEFT(%pExternal)))
#IF(INSTRING('|',%MIEN,1,1))
  #SET(%MIEN,CLIP(SUB(%MIEN,1,INSTRING('|',%MIEN,1,1)-1)))
#ENDIF
#IF(SUB(%MIEN,1,1)='''')
  #SET(%MIEN,SUB(%MIEN,2,LEN(%MIEN)-1))
#ENDIF
#IF(LEN(%MIEN) > 0 AND SUB(%MIEN,LEN(%MIEN),1)='''')
  #SET(%MIEN,SUB(%MIEN,1,LEN(%MIEN)-1))
#ENDIF
#IF(INSTRING('''',%MIEN,1,1))
  #SET(%MIEN,'')
#ENDIF
#SET(%MIEN,CLIP(LEFT(%MIEN)))
#IF(%MIEN='')
  #SET(%MIEN,%pId)
#ENDIF
#RETURN(%MIEN)
#!
#!----------------------------------------------------------------------------
#! Picture for a field that has none in the dictionary
#!----------------------------------------------------------------------------
#GROUP(%MIEFallbackPicture,%pType,%pPlaces)
#IF(%pType='DATE')
  #RETURN('@d10-')
#ELSIF(%pType='TIME')
  #RETURN('@t4')
#ELSIF(%pType='STRING' OR %pType='CSTRING' OR %pType='PSTRING')
