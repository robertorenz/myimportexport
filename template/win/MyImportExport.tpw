#ENDIF
#RETURN('@n-14')
#!
#!----------------------------------------------------------------------------
#! A prompt value as a Clarion expression: '!expr' = expr, else a quoted literal
#!----------------------------------------------------------------------------
#GROUP(%MIEValueExpr,%pValue)
#IF(SUB(%pValue,1,1)='!')
  #RETURN(SUB(%pValue,2,LEN(%pValue)-1))
#ENDIF
#RETURN('''' & QUOTE(%pValue) & '''')
#!
#!----------------------------------------------------------------------------
#! The procedure's primary table: first browse, else the form (SaveButton).
#!----------------------------------------------------------------------------
#GROUP(%MIEProcPrimary),PRESERVE,AUTO
#DECLARE(%MIERet)
#SET(%MIERet,'')
#FOR(%ActiveTemplate),WHERE(%ActiveTemplate='BrowseBox(ABC)' OR %ActiveTemplate='BrowseBox(Clarion)')
  #FOR(%ActiveTemplateInstance)
    #CONTEXT(%Procedure,%ActiveTemplateInstance)
      #IF(%MIERet='' AND %Primary)
        #SET(%MIERet,%Primary)
      #ENDIF
    #ENDCONTEXT
  #ENDFOR
#ENDFOR
#IF(%MIERet='')
  #FOR(%ActiveTemplate),WHERE(%ActiveTemplate='SaveButton(ABC)' OR %ActiveTemplate='SaveButton(Clarion)')
    #FOR(%ActiveTemplateInstance)
      #CONTEXT(%Procedure,%ActiveTemplateInstance)
        #IF(%MIERet='' AND %Primary)
          #SET(%MIERet,%Primary)
        #ENDIF
      #ENDCONTEXT
    #ENDFOR
  #ENDFOR
#ENDIF
#RETURN(%MIERet)
#!
#!----------------------------------------------------------------------------
#! Call MIE_ImportExport, optionally refreshing the window on success
#!----------------------------------------------------------------------------
#GROUP(%MIECallAndRefresh,%pTable,%pMode,%pRefresh)
#IF(%pRefresh)
IF MIE_ImportExport('%pTable',%pMode)
  #INSERT(%MIERefreshWindow)
END
#ELSE
MIE_ImportExport('%pTable',%pMode)
#ENDIF
#!
#GROUP(%MIERefreshWindow)
#IF(UPPER(%AppTemplateFamily)='CLARION')
ForceRefresh = True
DO RefreshWindow
#ELSIF(VAREXISTS(%WindowManager))
  #IF(%WindowManager)
%WindowManager.Reset(1)
  #ENDIF
#ENDIF
#!
#!----------------------------------------------------------------------------
#! The generated module <program>_MIE.clw
#!----------------------------------------------------------------------------
#GROUP(%MIEWriteModule)
  MEMBER('%Program')
!============================================================================
! %MIEModuleFile - generated by the MyImportExport template.
! Do not edit: change the template prompts / embeds and regenerate.
#IF(%MIEIncFound)
! Class header : %MIEIncFile (%(ITEMS(%MIEIncMethods)) methods; derives _MIELinkMode_ itself: %(CHOOSE(%MIEIncDefinesLink=1,'yes','no')))
#ELSE
! Class header : MyImportExport.inc NOT found on the redirection path at generate time
#ENDIF
! Template family: %AppTemplateFamily (ABC hooks: %MIEIsABC)
! Class code   : _MIEDllMode_=%MIEDllMode (%(CHOOSE(%MIEDllMode=1,'imported from a DLL','compiled into this app')))
!============================================================================

  INCLUDE('MyImportExport.inc'),ONCE

  MAP
  END

!----------------------------------------------------------------------------
! MIE_DictClass - MyImportExportClass bound to this application's dictionary.
!   SetupTable(name) registers a table (SetTable + AddField) by its label;
!   the hooks route every table through its ABC FileManager / RelationManager.
!   Used by MIE_ImportExport and MIE_ExportTables.
!----------------------------------------------------------------------------
MIE_DictClass        CLASS(MyImportExportClass),TYPE
#IF(%MIEIsABC)
FM                     &FileManager
RM                     &RelationManager
FMOpens                LONG
#ENDIF
Prepare                PROCEDURE
SetupTable             PROCEDURE(STRING pName),BYTE,DERIVED
#IF(%MIEIsABC)
OpenTable              PROCEDURE(),BYTE,DERIVED
CloseTable             PROCEDURE(),DERIVED
PrimeRecord            PROCEDURE(),DERIVED
CancelPrime            PROCEDURE(),DERIVED
InsertRecord           PROCEDURE(),BYTE,DERIVED
UpdateRecord           PROCEDURE(),BYTE,DERIVED
FetchRecord            PROCEDURE(),BYTE,DERIVED
DeleteRecord           PROCEDURE(),BYTE,DERIVED
#ENDIF
ValidateRecord         PROCEDURE(),BYTE,DERIVED
ExportFilter           PROCEDURE(),BYTE,DERIVED
                     END

!----------------------------------------------------------------------------
! MIE_ImportExport(pTable, pMode)
!   pTable : dictionary table label; blank = the user picks a table
!   pMode  : 0 = ask, MIE:Mode:Export or MIE:Mode:Import
!   returns: 1 = something was imported / exported, 0 = cancelled / failed
!----------------------------------------------------------------------------
MIE_ImportExport     PROCEDURE(STRING pTable,BYTE pMode)
TableName            STRING(100)
Result               BYTE
PickRow              LONG
PickQueue            QUEUE
TableLabel             STRING(64)
TableDesc              STRING(128)
                     END
PickWindow           WINDOW('Import / Export - choose a table'),AT(,,300,196),FONT('Segoe UI',9),CENTER,GRAY,SYSTEM,DOUBLE
                       PROMPT('Choose the table to import into or export from:'),AT(6,6,288,10),USE(?PickPrompt)
                       LIST,AT(6,18,288,152),USE(?PickList),VSCROLL,FROM(PickQueue),FORMAT('90L(2)|M~Table~@s64@200L(2)~Description~@s128@')
                       BUTTON('&OK'),AT(190,176,50,14),USE(?PickOK),DEFAULT
                       BUTTON('Cancel'),AT(244,176,50,14),USE(?PickCancel)
                     END
ThisMIE              MIE_DictClass
#EMBED(%MIEProcData,'MIE_ImportExport - local data'),DATA,TREE('MyImportExport|MIE_ImportExport procedure|0 - Local data')
  CODE
  #EMBED(%MIEProcStart,'MIE_ImportExport - start (pTable / pMode may be changed here)'),TREE('MyImportExport|MIE_ImportExport procedure|1 - Start of procedure')
  Result = 0
  TableName = pTable
  IF TableName = ''
    DO PickTable
    IF TableName = ''
      RETURN 0
    END
  END
  ThisMIE.Prepare()
  IF ThisMIE.SetupTable(TableName) <> 0
    ThisMIE.ShowMessage('MyImportExport: the table "' & CLIP(TableName) & '" is not available for import / export.','Import / Export')
    ThisMIE.Kill()
    RETURN 0
  END
  #EMBED(%MIEAfterFields,'MIE_ImportExport - fields added, before the saved mapping is loaded'),TREE('MyImportExport|MIE_ImportExport procedure|2 - Fields added, before LoadMap')
  ThisMIE.LoadMap()
  #EMBED(%MIEBeforeAsk,'MIE_ImportExport - before Ask (mapping loaded)'),TREE('MyImportExport|MIE_ImportExport procedure|3 - Before Ask')
  Result = ThisMIE.Ask(pMode)
  #EMBED(%MIEAfterAsk,'MIE_ImportExport - after Ask (Result = 1 when something was done)'),TREE('MyImportExport|MIE_ImportExport procedure|4 - After Ask')
  ThisMIE.Kill()
  RETURN Result

!----------------------------------------------------------------------------
PickTable            ROUTINE
  FREE(PickQueue)
#FOR(%MIETables)
  #FIX(%File,%MIETables)
  PickQueue.TableLabel = '%File'
  PickQueue.TableDesc = '%(QUOTE(%FileDescription))'
  ADD(PickQueue)
#ENDFOR
  SORT(PickQueue,PickQueue.TableLabel)
  TableName = ''
  PickRow = 1
  OPEN(PickWindow)
  ACCEPT
    CASE EVENT()
    OF EVENT:OpenWindow
      IF RECORDS(PickQueue)
        SELECT(?PickList,1)
      END
    OF EVENT:NewSelection
      IF FIELD() = ?PickList
        PickRow = CHOICE(?PickList)               ! recorded here: CHOICE() is only valid while the list has focus
      END
    OF EVENT:Accepted
      CASE FIELD()
      OF ?PickList
        PickRow = CHOICE(?PickList)               ! double-click / Enter on the list
        POST(EVENT:Accepted,?PickOK)
      OF ?PickOK
        IF PickRow < 1 OR PickRow > RECORDS(PickQueue)
          PickRow = 1
        END
        GET(PickQueue,PickRow)
        IF NOT ERRORCODE()
          TableName = PickQueue.TableLabel
        END
        POST(EVENT:CloseWindow)
      OF ?PickCancel
        TableName = ''
        POST(EVENT:CloseWindow)
      END
    END
  END
  CLOSE(PickWindow)

!----------------------------------------------------------------------------
! MIE_ExportTables(pTables)
!   pTables : optional comma-separated table labels to pre-select
!             (omitted / blank = the selection saved last time)
!   returns : 1 = exported, 0 = cancelled / failed
!   JSON / XML / XLSX / XLS write every table into one file; CSV / TSV
!   write one file per table.
!----------------------------------------------------------------------------
MIE_ExportTables     PROCEDURE(<STRING pTables>)
Result               BYTE
Want                 CSTRING(4096)
Pos                  LONG
ThisMIE              MIE_DictClass
#EMBED(%MIETablesData,'MIE_ExportTables - local data'),DATA,TREE('MyImportExport|MIE_ExportTables procedure|0 - Local data')
  CODE
  #EMBED(%MIETablesStart,'MIE_ExportTables - start of procedure'),TREE('MyImportExport|MIE_ExportTables procedure|1 - Start of procedure')
  Result = 0
  ThisMIE.Prepare()
#FOR(%MIETables)
  #FIX(%File,%MIETables)
  ThisMIE.AddTable('%File','%(QUOTE(%FileDescription))')
#ENDFOR
  ThisMIE.LoadTablesMap()
  IF NOT OMITTED(pTables)
    IF CLIP(pTables) <> ''
      Want = ','
      LOOP Pos = 1 TO LEN(CLIP(pTables))
        IF pTables[Pos] <> ' ' THEN Want = Want & UPPER(pTables[Pos]).
      END
      Want = Want & ','
      LOOP Pos = 1 TO RECORDS(ThisMIE.Tables)
        GET(ThisMIE.Tables,Pos)
        IF INSTRING(',' & UPPER(CLIP(ThisMIE.Tables.Name)) & ',',Want,1,1)
          ThisMIE.Tables.Selected = 1
        ELSE
          ThisMIE.Tables.Selected = 0
        END
        PUT(ThisMIE.Tables)
      END
    END
  END
  #EMBED(%MIEBeforeAskTables,'MIE_ExportTables - before AskTables (tables added, selection loaded)'),TREE('MyImportExport|MIE_ExportTables procedure|2 - Before AskTables')
  Result = ThisMIE.AskTables()
  #EMBED(%MIEAfterAskTables,'MIE_ExportTables - after AskTables (Result = 1 when exported)'),TREE('MyImportExport|MIE_ExportTables procedure|3 - After AskTables')
  ThisMIE.Kill()
  RETURN Result

!============================================================================
! MIE_DictClass methods
!============================================================================
MIE_DictClass.Prepare PROCEDURE
  CODE
  SELF.Init()
  SELF.HelperPath = %(%MIEValueExpr(%MIEHelper))
  IF SELF.HelperPath <> '' AND ~INSTRING(':',SELF.HelperPath,1,1) AND SUB(SELF.HelperPath,1,1) <> '\'
    SELF.HelperPath = SELF.ExeFolder() & SELF.HelperPath      ! a bare name: beside the program
  END
#IF(%MIEIniFile)
  SELF.IniFile = %(%MIEValueExpr(%MIEIniFile))
#ELSIF(%MIEIsABC)
  SELF.IniFile = INIMgr.FileName
#ENDIF
  SELF.Format = '%MIEFormat'
#IF(%MIEUsePictures)
  SELF.UsePictures = 1
#ELSE
  SELF.UsePictures = 0
#ENDIF
  #EMBED(%MIEPrepare,'Prepare - defaults set (helper, INI, format)'),TREE('MyImportExport|Hooks|Prepare (defaults)')

!----------------------------------------------------------------------------
! SetupTable: SetTable + AddField for one table by its label. 0 = known table
!----------------------------------------------------------------------------
MIE_DictClass.SetupTable PROCEDURE(STRING pName)
  CODE
  CASE UPPER(pName)
#FOR(%MIETables)
  #FIX(%File,%MIETables)
  OF '%(UPPER(%File))'                                          ! %FileDescription
  #IF(%MIEIsABC)
    SELF.FM &= Access:%File
    SELF.RM &= Relate:%File
  #ENDIF
  #IF(%FilePrimaryKey)
    SELF.SetTable(%File,'%File',%FilePrimaryKey)
  #ELSE
    SELF.SetTable(%File,'%File')
  #ENDIF
#INSERT(%MIEFieldLoop,1)
#ENDFOR
  ELSE
    RETURN PARENT.SetupTable(pName)
  END
  #EMBED(%MIESetupTable,'SetupTable - table and fields registered (SELF.TableName)'),TREE('MyImportExport|Hooks|SetupTable')
  RETURN 0
#IF(%MIEIsABC)

!----------------------------------------------------------------------------
! ABC hooks: every table goes through its FileManager / RelationManager
! (FM / RM are set per table in SetupTable, so no CASE is needed here).
! All of them return 0 = ok, like Level:Benign.
!----------------------------------------------------------------------------
MIE_DictClass.OpenTable PROCEDURE()
  CODE
  #EMBED(%MIEHookOpenTable,'OpenTable - before the table is opened'),TREE('MyImportExport|Hooks|OpenTable')
  IF SELF.FM &= NULL
    RETURN PARENT.OpenTable()
  END
  #IF(SUB(%MIEDeleteVia,1,8)='Relation')
  IF SELF.RM.Open() <> Level:Benign                ! opens the related tables too (RI on delete)
  #ELSE
  IF SELF.FM.Open() <> Level:Benign
  #ENDIF
    RETURN 1
  END
  SELF.FM.UseFile()
  SELF.FMOpens += 1
  RETURN 0

MIE_DictClass.CloseTable PROCEDURE()
  CODE
  #EMBED(%MIEHookCloseTable,'CloseTable - before the table is closed'),TREE('MyImportExport|Hooks|CloseTable')
  IF SELF.FM &= NULL
    PARENT.CloseTable()
    RETURN
  END
  IF SELF.FMOpens > 0
  #IF(SUB(%MIEDeleteVia,1,8)='Relation')
    SELF.RM.Close()
  #ELSE
    SELF.FM.Close()
  #ENDIF
    SELF.FMOpens -= 1
  END

MIE_DictClass.PrimeRecord PROCEDURE()
  CODE
  #EMBED(%MIEHookPrimeRecord,'PrimeRecord - before the new record is primed'),TREE('MyImportExport|Hooks|PrimeRecord')
  IF SELF.FM &= NULL
    PARENT.PrimeRecord()
  ELSE
    SELF.FM.PrimeRecord()                           ! clears the buffer, primes auto-increment
  END

MIE_DictClass.CancelPrime PROCEDURE()
  CODE
  #EMBED(%MIEHookCancelPrime,'CancelPrime - before a primed record is cancelled'),TREE('MyImportExport|Hooks|CancelPrime')
  IF SELF.FM &= NULL
    PARENT.CancelPrime()
  ELSE
    SELF.FM.CancelAutoInc()
  END

MIE_DictClass.InsertRecord PROCEDURE()
  CODE
  #EMBED(%MIEHookInsertRecord,'InsertRecord - before the record is added'),TREE('MyImportExport|Hooks|InsertRecord')
  IF SELF.FM &= NULL
    RETURN PARENT.InsertRecord()
  END
  IF SELF.KeyMapped AND SELF.FM.GetHasAutoInc()
    RETURN PARENT.InsertRecord()                    ! keep the imported key: TryInsert would renumber it
  END
  RETURN SELF.FM.TryInsert()

MIE_DictClass.UpdateRecord PROCEDURE()
  CODE
  #EMBED(%MIEHookUpdateRecord,'UpdateRecord - before the record is written back'),TREE('MyImportExport|Hooks|UpdateRecord')
  IF SELF.FM &= NULL
    RETURN PARENT.UpdateRecord()
  END
  RETURN SELF.FM.TryUpdate()

MIE_DictClass.FetchRecord PROCEDURE()
  CODE
  #EMBED(%MIEHookFetchRecord,'FetchRecord - before the record is read by its primary key'),TREE('MyImportExport|Hooks|FetchRecord')
  IF SELF.FM &= NULL
    RETURN PARENT.FetchRecord()
  END
  IF SELF.TableKey &= NULL
    RETURN 1
  END
  RETURN SELF.FM.TryFetch(SELF.TableKey)

MIE_DictClass.DeleteRecord PROCEDURE()
  CODE
  #EMBED(%MIEHookDeleteRecord,'DeleteRecord - before a record is deleted (Replace all)'),TREE('MyImportExport|Hooks|DeleteRecord')
  IF SELF.FM &= NULL
    RETURN PARENT.DeleteRecord()
  END
  #IF(SUB(%MIEDeleteVia,1,8)='Relation')
  RETURN SELF.RM.Delete(0)                          ! no confirmation, dictionary RI applies
  #ELSE
  RETURN SELF.FM.DeleteRecord(0)                    ! no confirmation, no cascade
  #ENDIF
#ENDIF

!----------------------------------------------------------------------------
! Rules: ValidateRecord (import, non-zero = skip the row) and
! ExportFilter (export, 0 = skip the record). SELF.TableName = table label.
!----------------------------------------------------------------------------
MIE_DictClass.ValidateRecord PROCEDURE()
ReturnValue          BYTE,AUTO
  CODE
  ReturnValue = PARENT.ValidateRecord()
  #EMBED(%MIEValidateRecord,'ValidateRecord - any table (ReturnValue = 1 skips the row)'),TREE('MyImportExport|Hooks|ValidateRecord|Any table')
